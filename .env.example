# ===== LLM (choose one provider) =====
# We use prefix-based auto-detection
LLM_MODEL_ID="gpt-4o-mini"

OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="your-openai-api-key"

# DeepSeek (default) — https://platform.deepseek.com
# DEEPSEEK_API_KEY="your-deepseek-api-key"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Zhipu GLM — https://open.bigmodel.cn
# GLM_API_KEY="your-glm-api-key"
# GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY="your-google-api-key"
# GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Anthropic Claude — https://console.anthropic.com
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# Alibaba Qwen — https://dashscope.console.aliyun.com
# QWEN_API_KEY="your-qwen-api-key"
# QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Offline Ollama — https://ollama.com
# LLM_PROVIDER="ollama"
# LLM_MODEL_ID="llama3.2:latest"
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_API_KEY="ollama"
# OLLAMA_DISABLE_TOOLS=true

# ===== Embedding =====
EMBEDDING_MODEL_ID="qwen3.7-text-embedding"
EMBEDDING_BASE_URL="your-embedding-base-url"
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_BATCH_SIZE=10

# ===== Search (at least one required, both have free tier) =====
BRAVE_API_KEY="your-brave-api-key"
TAVILY_API_KEY="your-tavily-api-key"
UNPAYWALL_EMAIL=your-email-address

# ===== Optional =====
CORE_API_KEY="your-core-api-key"
# REVIEW_MODEL_ID="qwen3.7"  # use a different LLM for quality review

GITHUB_TOKEN="your-github-token"
HF_TOKEN="your-hf-token"
# ===== RAG persistence =====
QDRANT_URL="https://<cluster-id>.<region>.<provider>.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION=iceberg_search_chunks
QDRANT_TIMEOUT=10
